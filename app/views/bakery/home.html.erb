<div class="announcement-bar">Horneado con cariño en Santa Clara <span aria-hidden="true">✦</span> Pedidos por WhatsApp</div>

<header class="app-bar">
  <button type="button" class="drawer-toggle" aria-label="Abrir menú" aria-controls="drawer" aria-expanded="false" data-drawer-toggle>
    <span></span><span></span><span></span>
  </button>
  <span class="app-bar-name"><%= @bakery.name %></span>
  <a class="app-bar-order" href="#visitanos">Visítanos <span aria-hidden="true">↗</span></a>
</header>

<div class="drawer-backdrop" data-drawer-backdrop></div>

<nav id="drawer" class="drawer" aria-label="Categorías de productos">
  <h2>Categorías</h2>
  <ul>
    <% @bakery.categories.each do |category| %>
      <li><a href="#<%= @bakery.category_anchor(category) %>" data-drawer-link><%= category %></a></li>
    <% end %>
  </ul>
</nav>

<main class="bakery-page">
  <section class="bakery-hero">
    <div class="hero-copy">
      <p class="eyebrow">PANADERÍA ARTESANAL <span aria-hidden="true">✦</span> DESDE SANTA CLARA</p>
      <h1>Un poquito de <em>dulce</em> para cada día.</h1>
      <p class="tagline"><%= @bakery.tagline %></p>
      <a class="hero-cta" href="#panes">Descubre el menú <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-mark">
      <div class="hero-sparkle hero-sparkle-one" aria-hidden="true">✦</div>
      <%= image_tag "dulces_lore.png", alt: "Logo de Dulces Lore", class: "hero-logo" %>
      <div class="hero-sparkle hero-sparkle-two" aria-hidden="true">✷</div>
    </div>
  </section>

  <nav class="category-pills" aria-label="Explorar categorías">
    <span class="category-label">Hoy se antoja:</span>
    <% @bakery.categories.each do |category| %>
      <a href="#<%= @bakery.category_anchor(category) %>"><%= category %> <span aria-hidden="true">↘</span></a>
    <% end %>
  </nav>

  <% @bakery.products_by_category.each do |category, products| %>
    <section id="<%= @bakery.category_anchor(category) %>" class="product-category">
      <div class="section-heading">
        <p class="section-kicker">NUESTROS FAVORITOS</p>
        <h2><%= category %><span aria-hidden="true">.</span></h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="product-grid">
        <% products.each do |product| %>
          <article class="product-card">
            <% if product.image_path.present? %>
              <%= image_tag product.image_path, alt: product.name, class: "product-image", onerror: "this.remove()" %>
            <% else %>
              <div class="product-art" aria-hidden="true"><span>✦</span><strong><%= product.name.first %></strong></div>
            <% end %>
            <div class="product-details">
              <h3><%= product.name %></h3>
              <p><%= product.description %></p>
              <span class="product-arrow" aria-hidden="true">↗</span>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="bakery-info" id="visitanos">
    <div>
      <p class="section-kicker">VEN A VERNOS</p>
      <h2>El mejor plan<br><em>empieza aquí.</em></h2>
    </div>
    <div class="visit-details">
      <p><strong>Dirección</strong><%= @bakery.address %></p>
      <p><strong>Horario</strong><%= @bakery.business_hours %></p>
      <a class="text-link" href="https://wa.me/<%= @bakery.whatsapp_number.gsub(/\D/, "") %>" target="_blank" rel="noopener">Escríbenos <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="bakery-about" id="sobre-nosotros">
    <div class="about-stamp" aria-hidden="true">HECHO<br>CON<br>AMOR <span>♥</span></div>
    <div>
      <p class="section-kicker">UNA HISTORIA MUY DULCE</p>
      <h2>Recetas con memoria,<br><em>momentos para compartir.</em></h2>
      <p><%= @bakery.tagline %></p>
    </div>
    <div class="bakery-social">
      <p>Redes sociales próximamente <span aria-hidden="true">✦</span></p>
    </div>
  </section>
</main>

<%= link_to "Contactar por WhatsApp", whatsapp_link(@bakery), class: "whatsapp-floating-button", target: "_blank", rel: "noopener", data: { whatsapp_fab: true } %>

<%= javascript_include_tag "bakery", defer: true %>

